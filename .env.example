# Variables globales pour docker-compose (copiez en .env et ajustez)

# Ports hôtes
CLIENT_PORT=5173
SERVER_PORT=8000
REDIS_PORT=6379

# API exposée au client (utilisée pendant le build Vite)
# Remplacer manuellement si vous changez SERVER_PORT
VITE_API_BASE=http://localhost:8000

# Redis
REDIS_HOST=redis
REDIS_DB=0
REDIS_PASSWORD=

# Sécurité / Auth (exemples — ajustez selon votre app)
JWT_SECRET=change-me
JWT_EXPIRES_IN=3600
